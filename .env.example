# LLM + embedding provider (optional).
# Leave OPENAI_API_KEY unset to run fully offline with the built-in
# deterministic hashing embedder — great for tests, demos, and CI.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
EMBED_MODEL="text-embedding-3-small"
CHAT_MODEL="gpt-4o-mini"

# Where the vector index is persisted.
LUMEN_INDEX_DIR=".lumen_index"

# Optional. When set, /reset requires this value in the X-Admin-Key header.
# Set this on any publicly reachable deployment (e.g. the HF Space) so
# random visitors can't wipe the shared index for everyone else.
ADMIN_KEY=""
