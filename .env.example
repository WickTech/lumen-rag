# LLM + embedding provider (optional).
# Leave OPENAI_API_KEY unset to run fully offline with the built-in
# deterministic hashing embedder — great for tests, demos, and CI.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
EMBED_MODEL="text-embedding-3-small"
CHAT_MODEL="gpt-4o-mini"

# Embedder: auto (OpenAI when OPENAI_API_KEY is set, else hashing), hashing,
# fastembed (local BAAI/bge-small-en-v1.5 on CPU; pip install 'lumen-rag[embed]')
# or openai. A saved index must be re-ingested after switching embedders.
LUMEN_EMBEDDER="auto"
LUMEN_FASTEMBED_MODEL="BAAI/bge-small-en-v1.5"

# Optional: refuse questions whose retrieval confidence is below this value.
# Calibrate per embedder with: scripts/benchmark.py --set v2 --abstain
# (0.66 for fastembed bge-small in vector mode; empty disables).
LUMEN_ABSTAIN_THRESHOLD=""

# Optional second gate: an extractive SQuAD 2.0 reader (ONNX, CPU; pip install
# 'lumen-rag[reader]') reads the retrieved passages and refuses when none contains
# an answer, which catches near misses that similarity lets through.
# onnx-community/roberta-base-squad2-ONNX (accurate, ~1 s/query on CPU) or
# onnx-community/tinyroberta-squad2-ONNX (faster, weaker). -3.5 is calibrated for
# roberta-base on eval set v2. LUMEN_READER_ANSWERS="1" also answers offline with
# the sentence holding the span instead of the top passages.
LUMEN_READER=""
LUMEN_READER_THRESHOLD="-3.5"
LUMEN_READER_ANSWERS=""

# "1" embeds and BM25-indexes each chunk with "Document: <title>. Section: <headings>."
# Helps keyword/hybrid search most (see README Benchmarks). Re-ingest after changing it.
LUMEN_CONTEXTUAL=""

# Experimental: split compound questions into sub-questions ("..., and how soon...?").
# Measured no gain on eval set v2 with bge-small (see README Benchmarks); off by default.
LUMEN_DECOMPOSE=""

# Where the vector index is persisted.
LUMEN_INDEX_DIR=".lumen_index"

# Optional. When set, /ingest, /ingest/upload, /ingest/sample and /reset require
# this value in the X-Admin-Key header (401 otherwise). When unset they are open
# locally, but refused (403) on a Hugging Face Space (detected by SPACE_ID), so
# random visitors can't fill, poison or wipe the shared index.
ADMIN_KEY=""

# "1" loads the bundled sample corpus (data/docs) at startup when the index is
# empty. Defaults to on when SPACE_ID is set (the hosted demo), off otherwise.
LUMEN_SEED_SAMPLE=""

# Ingestion bounds: bytes per uploaded file, files per /ingest/upload request,
# and the allowed chunk_size range in words (overlap must be 0..chunk_size-1).
LUMEN_MAX_UPLOAD_BYTES="10485760"
LUMEN_MAX_UPLOAD_FILES="20"
LUMEN_MIN_CHUNK_SIZE="20"
LUMEN_MAX_CHUNK_SIZE="1000"

# Optional second-stage cross-encoder reranker (pip install 'lumen-rag[rerank]').
# Leave empty to disable. Good defaults: BAAI/bge-reranker-base (fast),
# BAAI/bge-reranker-v2-m3 (multilingual, stronger, slower).
LUMEN_RERANKER=""
LUMEN_RERANK_POOL="4"

# Optional: "1" parses PDF/DOCX/PPTX/HTML with Docling for layout- and
# table-aware extraction (pip install 'lumen-rag[docling]').
LUMEN_DOCLING=""
